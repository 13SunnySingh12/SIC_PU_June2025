# Copy this file to `.env` in the same folder and fill in real values.
# .env is gitignored and is loaded automatically by the scripts below -
# real environment variables, if set, take precedence over it.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=sunny_db

# Used by weather_client/weather_report.py
OPENWEATHER_API_KEY=your-openweathermap-key
